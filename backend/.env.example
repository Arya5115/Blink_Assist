# Copy this file to backend/.env and replace every value. Never commit backend/.env.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=replace_with_your_auth_token
TWILIO_FROM_NUMBER=+15005550006

# If Twilio says the route requires a template, create/select its approved
# Content Template in the Twilio Console and put its HX... Content SID here.
# The template should accept variables 1 (patient) and 2 (alert action).
# TWILIO_CONTENT_SID=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional. Needed only for WhatsApp notifications, and must be enabled in Twilio.
# TWILIO_WHATSAPP_FROM=+14155238886
